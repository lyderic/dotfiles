common-version := "20260815-0"

alias up    := base::update
alias vi    := base::vigilax
alias geo   := base::geolocate
alias ip    := base::ip
alias ansi  := base::ansi
alias h     := _help
{{- if lookPath "wg-status" }}
alias wgw   := wgwatch
{{- end }}

_help:
	@just --list --unsorted --alias-style left --color always \
		--list-heading= --list-prefix='  ' \
		| sed -e "s/\[alias: /\[/" | awk 'NF' | grep -v 'base::'

# used by vim's ansi plugin
_wait:
	#!/bin/bash
	echo -ne "\e[2;3;34mPlease any key to continue...\e[m"
	read -sn 1
	echo

{{ $thisdistro := .chezmoi.osRelease.id -}}
{{- $systemddistros := list "arch" "debian" "ubuntu" "fedora" -}}
{{- range $k, $v := $systemddistros -}}
	{{- if eq $thisdistro $v -}}
# Nice show of services for status (systemd)
_services:
	#!/bin/bash
	[ -z "${services}" ] && exit 0
	max=0
	for word in ${services}; do
		ln=${#word}
		((ln > max)) && max=$ln
	done
	sc="\e[1m"; up="\e[32m"; down="\e[2m"; nc="\e[m"
	for service in ${services} ; do
		e=$($sys is-enabled "${service}")
		a=$($sys is-active "${service}")
		[ "${e}" == "enabled" ] && ec="${up}" || ec="${down}"
		[ "${a}" == "active" ] && ac="${up}" || ac="${down}"
		printf "${sc}%-*s${nc}   ${ec}%-10.10s${nc} ${ac}%s${nc}\n" \
		$max "${service}" "${e}" "${a}"
	done
	{{- end -}}
{{- end -}}
{{- if eq .chezmoi.osRelease.id "alpine" -}}
# Nice show of services for status (openrc)
_services:
	#!/bin/bash
	[ -z "${services}" ] && exit 0
	max=0
	for word in ${services}; do
		ln=${#word}
		((ln > max)) && max=$ln
	done
	rcs="rc-service"
	for service in ${services} ; do
		printf "\e[1m%-*s\e[m  " $max "${service}"
		$rcs -e "${service}" || {
			echo -e "\e[33mnot found\e[m"
			continue
		}
		$rcs -q "${service}" status && {
			echo -en "\e[32mstarted"
		} || {
			echo -en "\e[31mstopped"
		}
		echo -e "\e[m"
	done
	exit 0
{{- end }}

{{ if lookPath "wg-status" -}}
wgwatch:
	@sudo watch -c -n 5 wg-status
{{- end }}

# BAse CONfiguration files
# To use:
# When you run 'just _bacon', the global justfile and all these
# files in the optional 'baconfiles' variable will be copied
# into ~/.bacon.
# This is useful for systemd services in /etc/systemd/system 
# and other configuration files
_bacon:
	#!/bin/bash
	set -e
	bacondir="${HOME}/.bacon"
	baconfiles="${HOME}/justfile ${baconfiles}"
	# we overwrite ~/.bacon always
	sudo rm -r "${bacondir}"
	mkdir -pv "${bacondir}"
	sudo tar -cPf - ${baconfiles} | tar -xvf - -C "${bacondir}"
	echo -ne "\e[32mbacon successful: "
	find "${bacondir}" -type f | wc -l
	echo -ne "\e[m"

